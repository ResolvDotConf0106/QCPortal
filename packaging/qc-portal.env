# QC Portal environment configuration
# Loaded by systemd via EnvironmentFile=

# Flask secret key — CHANGE THIS in production!
SECRET_KEY=kvm-qc-portal-change-me-in-production

# Flask environment
FLASK_ENV=production

# Optional: override database location (default: /opt/qc-portal/instance/qc_portal.db)
# DATABASE=/opt/qc-portal/instance/qc_portal.db

# Optional: override scripts directory
# SCRIPTS_DIR=/opt/qc-portal/app/scripts
